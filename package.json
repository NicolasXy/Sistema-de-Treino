{
  "name": "sistema-treinos-esportivos",
  "version": "1.0.0",
  "description": "API REST de treinos esportivos com carga e risco de sobrecarga (Node.js + Express + Sequelize + MySQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "test": "node --test tests/carga.test.js",
    "test:api": "node --test --test-concurrency=1 tests/api.test.js"
  },
  "engines": { "node": ">=18" },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.11.0",
    "sequelize": "^6.37.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.2"
  }
}
